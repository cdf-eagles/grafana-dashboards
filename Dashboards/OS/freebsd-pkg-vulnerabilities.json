{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "freebsd-pkg-vulnerabilities"
  },
  "spec": {
    "annotations": [
      {
        "kind": "AnnotationQuery",
        "spec": {
          "builtIn": true,
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "query": {
            "datasource": {
              "name": "-- Grafana --"
            },
            "group": "grafana",
            "kind": "DataQuery",
            "spec": {},
            "version": "v0"
          }
        }
      }
    ],
    "cursorSync": "Off",
    "description": "pkg audit results from the FreeBSD hosts' daily pkg-update job, split by whether the package repository offers a version pkg audit does not flag. FreeBSDPkgVulnerable alerts on the fixable ones only.",
    "editable": true,
    "elements": {
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "cei7lwvco16o0b"
                      },
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "expr": "max by (instance) (pkg_audit_fixable_packages)",
                        "instant": true,
                        "range": false,
                        "legendFormat": "{{instance}}"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "Installed packages pkg audit flags for which the package repository offers a newer version it does not flag. FreeBSDPkgVulnerable fires on any host above zero; a patching window clears them.",
          "id": 1,
          "links": [],
          "title": "Fixable packages per host",
          "vizConfig": {
            "group": "bargauge",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "mode": "thresholds"
                  },
                  "decimals": 0,
                  "min": 0,
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "green",
                        "value": 0
                      },
                      {
                        "color": "orange",
                        "value": 1
                      }
                    ]
                  }
                },
                "overrides": []
              },
              "options": {
                "displayMode": "basic",
                "legend": {
                  "calcs": [],
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": false
                },
                "maxVizHeight": 300,
                "minVizHeight": 16,
                "minVizWidth": 8,
                "namePlacement": "left",
                "orientation": "horizontal",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "showUnfilled": true,
                "sizing": "auto",
                "valueMode": "color"
              }
            },
            "version": "13.2.4"
          }
        }
      },
      "panel-2": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "cei7lwvco16o0b"
                      },
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "expr": "max by (instance, package) (pkg_audit_vulnerable_package{fix=\"available\"})",
                        "instant": true,
                        "range": false,
                        "legendFormat": "",
                        "format": "table"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": [
                {
                  "group": "organize",
                  "kind": "Transformation",
                  "spec": {
                    "options": {
                      "excludeByName": {
                        "Time": true,
                        "Value": true
                      },
                      "indexByName": {
                        "instance": 0,
                        "package": 1
                      },
                      "renameByName": {
                        "instance": "Host",
                        "package": "Installed package"
                      }
                    }
                  }
                }
              ]
            }
          },
          "description": "Flagged packages the next patching window upgrades to a version pkg audit does not flag.",
          "id": 2,
          "links": [],
          "title": "Fixable: a newer package is in the repository",
          "vizConfig": {
            "group": "table",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "mode": "fixed",
                    "fixedColor": "text"
                  },
                  "custom": {
                    "align": "left",
                    "cellOptions": {
                      "type": "auto"
                    },
                    "filterable": true,
                    "inspect": false
                  },
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "text",
                        "value": 0
                      }
                    ]
                  }
                },
                "overrides": []
              },
              "options": {
                "cellHeight": "sm",
                "showHeader": true,
                "sortBy": [
                  {
                    "desc": false,
                    "displayName": "Host"
                  }
                ]
              }
            },
            "version": "13.2.4"
          }
        }
      },
      "panel-3": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "cei7lwvco16o0b"
                      },
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "expr": "max by (instance, package, fix) (pkg_audit_vulnerable_package{fix!=\"available\"})",
                        "instant": true,
                        "range": false,
                        "legendFormat": "",
                        "format": "table"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": [
                {
                  "group": "organize",
                  "kind": "Transformation",
                  "spec": {
                    "options": {
                      "excludeByName": {
                        "Time": true,
                        "Value": true
                      },
                      "indexByName": {
                        "instance": 0,
                        "package": 1,
                        "fix": 2
                      },
                      "renameByName": {
                        "instance": "Host",
                        "package": "Installed package",
                        "fix": "Repository"
                      }
                    }
                  }
                }
              ]
            }
          },
          "description": "Flagged packages whose repository version is the same or still flagged (none), or that no repository carries (not_in_repo). Nothing alerts on these; a package moves to the fixable table by itself when a fixed version reaches the repository.",
          "id": 3,
          "links": [],
          "title": "No fix in the repository",
          "vizConfig": {
            "group": "table",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "mode": "fixed",
                    "fixedColor": "text"
                  },
                  "custom": {
                    "align": "left",
                    "cellOptions": {
                      "type": "auto"
                    },
                    "filterable": true,
                    "inspect": false
                  },
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "text",
                        "value": 0
                      }
                    ]
                  }
                },
                "overrides": []
              },
              "options": {
                "cellHeight": "sm",
                "showHeader": true,
                "sortBy": [
                  {
                    "desc": false,
                    "displayName": "Host"
                  }
                ]
              }
            },
            "version": "13.2.4"
          }
        }
      },
      "panel-4": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "cei7lwvco16o0b"
                      },
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "expr": "time() - max by (instance) (pkg_audit_db_timestamp_seconds)",
                        "instant": true,
                        "range": false,
                        "legendFormat": "{{instance}}"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "Time since pkg's vulnerability database was last updated on each host. FreeBSDPkgAuditStale fires past three days.",
          "id": 4,
          "links": [],
          "title": "Vulnerability database age",
          "vizConfig": {
            "group": "bargauge",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "mode": "thresholds"
                  },
                  "decimals": 1,
                  "min": 0,
                  "unit": "s",
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "green",
                        "value": 0
                      },
                      {
                        "color": "orange",
                        "value": 172800
                      },
                      {
                        "color": "red",
                        "value": 259200
                      }
                    ]
                  }
                },
                "overrides": []
              },
              "options": {
                "displayMode": "basic",
                "legend": {
                  "calcs": [],
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": false
                },
                "maxVizHeight": 300,
                "minVizHeight": 16,
                "minVizWidth": 8,
                "namePlacement": "left",
                "orientation": "horizontal",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "showUnfilled": true,
                "sizing": "auto",
                "valueMode": "color"
              }
            },
            "version": "13.2.4"
          }
        }
      }
    },
    "layout": {
      "kind": "GridLayout",
      "spec": {
        "items": [
          {
            "kind": "GridLayoutItem",
            "spec": {
              "element": {
                "kind": "ElementReference",
                "name": "panel-1"
              },
              "height": 8,
              "width": 12,
              "x": 0,
              "y": 0
            }
          },
          {
            "kind": "GridLayoutItem",
            "spec": {
              "element": {
                "kind": "ElementReference",
                "name": "panel-4"
              },
              "height": 8,
              "width": 12,
              "x": 12,
              "y": 0
            }
          },
          {
            "kind": "GridLayoutItem",
            "spec": {
              "element": {
                "kind": "ElementReference",
                "name": "panel-2"
              },
              "height": 12,
              "width": 12,
              "x": 0,
              "y": 8
            }
          },
          {
            "kind": "GridLayoutItem",
            "spec": {
              "element": {
                "kind": "ElementReference",
                "name": "panel-3"
              },
              "height": 12,
              "width": 12,
              "x": 12,
              "y": 8
            }
          }
        ]
      }
    },
    "links": [],
    "liveNow": false,
    "preload": false,
    "tags": [
      "freebsd",
      "pkg",
      "vulnerabilities"
    ],
    "timeSettings": {
      "autoRefresh": "5m",
      "autoRefreshIntervals": [
        "1m",
        "5m",
        "15m",
        "30m",
        "1h"
      ],
      "fiscalYearStartMonth": 0,
      "from": "now-24h",
      "hideTimepicker": false,
      "timezone": "browser",
      "to": "now"
    },
    "title": "FreeBSD Package Vulnerabilities",
    "variables": []
  }
}
