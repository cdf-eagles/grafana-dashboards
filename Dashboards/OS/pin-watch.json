{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "pin-watch"
  },
  "spec": {
    "annotations": [
      {
        "kind": "AnnotationQuery",
        "spec": {
          "builtIn": true,
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "query": {
            "datasource": {
              "name": "-- Grafana --"
            },
            "group": "grafana",
            "kind": "DataQuery",
            "spec": {},
            "version": "v0"
          }
        }
      }
    ],
    "cursorSync": "Off",
    "description": "pin-watch's weekly check of every hand-pinned runtime version (quadlet image tags, Ansible version variables, collections, and the PostgreSQL, MariaDB, Python and FreeBSD release lines) against upstream, from soundwave's pin_watch_* textfile metrics. PinSecurityUpdate, PinUpdatesWaiting, PinWatchStale and PinWatchLookupErrors alert on them.",
    "editable": true,
    "elements": {
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "cei7lwvco16o0b"
                      },
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "expr": "count(pin_watch_update_info{grade=\"security\"}) or vector(0)",
                        "instant": true,
                        "range": false,
                        "legendFormat": ""
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "Pins whose newer releases name a CVE, a GHSA or a security section, or whose release line is past its end of life. PinSecurityUpdate fires at once; open a backlog item the same day.",
          "id": 1,
          "links": [],
          "title": "Security updates",
          "vizConfig": {
            "group": "stat",
            "kind": "VizConfig",
            "version": "13.2.4",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "mode": "thresholds"
                  },
                  "unit": "none",
                  "decimals": 0,
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "green",
                        "value": 0
                      },
                      {
                        "color": "red",
                        "value": 1
                      }
                    ]
                  }
                },
                "overrides": []
              },
              "options": {
                "colorMode": "value",
                "graphMode": "none",
                "justifyMode": "auto",
                "orientation": "auto",
                "percentChangeColorMode": "standard",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "showPercentChange": false,
                "textMode": "auto",
                "wideLayout": true
              }
            }
          }
        }
      },
      "panel-2": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "cei7lwvco16o0b"
                      },
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "expr": "count(pin_watch_update_info{grade=~\"recommended|review|plan\"}) or vector(0)",
                        "instant": true,
                        "range": false,
                        "legendFormat": ""
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "Pins graded recommended (a patch release at least 3 days old), review (a minor release at least 14 days old) or plan (a major release, breaking-change notes, a hand-bump pin, or an end of life within 183 days). PinUpdatesWaiting sends one grouped message a week once one has waited 7 days.",
          "id": 2,
          "links": [],
          "title": "Updates to act on",
          "vizConfig": {
            "group": "stat",
            "kind": "VizConfig",
            "version": "13.2.4",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "mode": "thresholds"
                  },
                  "unit": "none",
                  "decimals": 0,
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "green",
                        "value": 0
                      },
                      {
                        "color": "orange",
                        "value": 1
                      }
                    ]
                  }
                },
                "overrides": []
              },
              "options": {
                "colorMode": "value",
                "graphMode": "none",
                "justifyMode": "auto",
                "orientation": "auto",
                "percentChangeColorMode": "standard",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "showPercentChange": false,
                "textMode": "auto",
                "wideLayout": true
              }
            }
          }
        }
      },
      "panel-3": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "cei7lwvco16o0b"
                      },
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "expr": "count(pin_watch_update_info{grade=~\"cooldown|hold\"}) or vector(0)",
                        "instant": true,
                        "range": false,
                        "legendFormat": ""
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "Pins with a newer release still inside its cooldown, or on a dated hold in the manifest. Shown, never alerted (a security release breaks through a hold).",
          "id": 3,
          "links": [],
          "title": "In cooldown or held",
          "vizConfig": {
            "group": "stat",
            "kind": "VizConfig",
            "version": "13.2.4",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "mode": "thresholds"
                  },
                  "unit": "none",
                  "decimals": 0,
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "blue",
                        "value": 0
                      }
                    ]
                  }
                },
                "overrides": []
              },
              "options": {
                "colorMode": "value",
                "graphMode": "none",
                "justifyMode": "auto",
                "orientation": "auto",
                "percentChangeColorMode": "standard",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "showPercentChange": false,
                "textMode": "auto",
                "wideLayout": true
              }
            }
          }
        }
      },
      "panel-4": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "cei7lwvco16o0b"
                      },
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "expr": "count(pin_watch_lookup_ok)",
                        "instant": true,
                        "range": false,
                        "legendFormat": "watched"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "cei7lwvco16o0b"
                      },
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "expr": "count(pin_watch_unwatched) or vector(0)",
                        "instant": true,
                        "range": false,
                        "legendFormat": "unwatched"
                      },
                      "version": "v0"
                    },
                    "refId": "B"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "Pins looked up upstream, and pins with no public upstream (unwatched, such as the private ansible-common collection).",
          "id": 4,
          "links": [],
          "title": "Pins watched",
          "vizConfig": {
            "group": "stat",
            "kind": "VizConfig",
            "version": "13.2.4",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "mode": "thresholds"
                  },
                  "unit": "none",
                  "decimals": 0,
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "blue",
                        "value": 0
                      }
                    ]
                  }
                },
                "overrides": []
              },
              "options": {
                "colorMode": "value",
                "graphMode": "none",
                "justifyMode": "auto",
                "orientation": "auto",
                "percentChangeColorMode": "standard",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "showPercentChange": false,
                "textMode": "value_and_name",
                "wideLayout": true
              }
            }
          }
        }
      },
      "panel-5": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "cei7lwvco16o0b"
                      },
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "expr": "max(pin_watch_errors)",
                        "instant": true,
                        "range": false,
                        "legendFormat": ""
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "Upstream or Prometheus lookups that failed in the last run (pin_watch_errors). Read the pin-watch lines in /var/log/all.log on soundwave. PinWatchLookupErrors fires after two failed runs.",
          "id": 5,
          "links": [],
          "title": "Lookup errors",
          "vizConfig": {
            "group": "stat",
            "kind": "VizConfig",
            "version": "13.2.4",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "mode": "thresholds"
                  },
                  "unit": "none",
                  "decimals": 0,
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "green",
                        "value": 0
                      },
                      {
                        "color": "red",
                        "value": 1
                      }
                    ]
                  }
                },
                "overrides": []
              },
              "options": {
                "colorMode": "value",
                "graphMode": "none",
                "justifyMode": "auto",
                "orientation": "auto",
                "percentChangeColorMode": "standard",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "showPercentChange": false,
                "textMode": "auto",
                "wideLayout": true
              }
            }
          }
        }
      },
      "panel-6": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "cei7lwvco16o0b"
                      },
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "expr": "time() - max(pin_watch_last_run_timestamp_seconds)",
                        "instant": true,
                        "range": false,
                        "legendFormat": ""
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "Time since pin-watch last ran on soundwave (Saturdays 06:45). PinWatchStale fires past 8 days.",
          "id": 6,
          "links": [],
          "title": "Since the last run",
          "vizConfig": {
            "group": "stat",
            "kind": "VizConfig",
            "version": "13.2.4",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "mode": "thresholds"
                  },
                  "unit": "s",
                  "decimals": 1,
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "green",
                        "value": 0
                      },
                      {
                        "color": "orange",
                        "value": 608400
                      },
                      {
                        "color": "red",
                        "value": 691200
                      }
                    ]
                  }
                },
                "overrides": []
              },
              "options": {
                "colorMode": "value",
                "graphMode": "none",
                "justifyMode": "auto",
                "orientation": "auto",
                "percentChangeColorMode": "standard",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "showPercentChange": false,
                "textMode": "auto",
                "wideLayout": true
              }
            }
          }
        }
      },
      "panel-7": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "cei7lwvco16o0b"
                      },
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "expr": "max by (pin, current, latest, grade, reason, url) (pin_watch_update_info)",
                        "instant": true,
                        "range": false,
                        "legendFormat": "",
                        "format": "table"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": [
                {
                  "group": "organize",
                  "kind": "Transformation",
                  "spec": {
                    "options": {
                      "excludeByName": {
                        "Time": true,
                        "Value": true
                      },
                      "indexByName": {
                        "pin": 0,
                        "current": 1,
                        "latest": 2,
                        "grade": 3,
                        "reason": 4,
                        "url": 5
                      },
                      "renameByName": {
                        "pin": "Pin",
                        "current": "Pinned",
                        "latest": "Latest",
                        "grade": "Grade",
                        "reason": "Reason"
                      }
                    }
                  }
                }
              ]
            }
          },
          "description": "Every pin with a newer upstream release, at its highest grade. The pin's name links to the newest release's notes; /var/db/pin-watch/report.json on soundwave lists every newer release with its own grade and link. A silence on the alert acknowledges an update; the bump itself is a backlog item.",
          "id": 7,
          "links": [],
          "title": "Pending updates",
          "vizConfig": {
            "group": "table",
            "kind": "VizConfig",
            "version": "13.2.4",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "mode": "fixed",
                    "fixedColor": "text"
                  },
                  "custom": {
                    "align": "left",
                    "cellOptions": {
                      "type": "auto"
                    },
                    "filterable": true,
                    "inspect": false
                  },
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "text",
                        "value": 0
                      }
                    ]
                  }
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Grade"
                    },
                    "properties": [
                      {
                        "id": "mappings",
                        "value": [
                          {
                            "type": "value",
                            "options": {
                              "security": {
                                "color": "red",
                                "index": 0
                              },
                              "recommended": {
                                "color": "orange",
                                "index": 1
                              },
                              "review": {
                                "color": "yellow",
                                "index": 2
                              },
                              "plan": {
                                "color": "blue",
                                "index": 3
                              },
                              "hold": {
                                "color": "purple",
                                "index": 4
                              },
                              "cooldown": {
                                "color": "text",
                                "index": 5
                              }
                            }
                          }
                        ]
                      },
                      {
                        "id": "custom.cellOptions",
                        "value": {
                          "type": "color-text"
                        }
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "url"
                    },
                    "properties": [
                      {
                        "id": "custom.hidden",
                        "value": true
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Pin"
                    },
                    "properties": [
                      {
                        "id": "links",
                        "value": [
                          {
                            "title": "Release notes for ${__data.fields.Latest}",
                            "url": "${__data.fields.url}",
                            "targetBlank": true
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              "options": {
                "cellHeight": "sm",
                "showHeader": true,
                "sortBy": [
                  {
                    "desc": false,
                    "displayName": "Pin"
                  }
                ]
              }
            }
          }
        }
      },
      "panel-8": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "cei7lwvco16o0b"
                      },
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "expr": "max by (pin, current, policy, source) (pin_watch_pin_info)",
                        "instant": true,
                        "range": false,
                        "legendFormat": "",
                        "format": "table"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "cei7lwvco16o0b"
                      },
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "expr": "max by (pin) (pin_watch_behind)",
                        "instant": true,
                        "range": false,
                        "legendFormat": "",
                        "format": "table"
                      },
                      "version": "v0"
                    },
                    "refId": "B"
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "cei7lwvco16o0b"
                      },
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "expr": "max by (pin) (pin_watch_running_match)",
                        "instant": true,
                        "range": false,
                        "legendFormat": "",
                        "format": "table"
                      },
                      "version": "v0"
                    },
                    "refId": "C"
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "cei7lwvco16o0b"
                      },
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "expr": "max by (pin) (pin_watch_lookup_ok)",
                        "instant": true,
                        "range": false,
                        "legendFormat": "",
                        "format": "table"
                      },
                      "version": "v0"
                    },
                    "refId": "D"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": [
                {
                  "group": "merge",
                  "kind": "Transformation",
                  "spec": {
                    "options": {}
                  }
                },
                {
                  "group": "organize",
                  "kind": "Transformation",
                  "spec": {
                    "options": {
                      "excludeByName": {
                        "Time": true,
                        "Value #A": true
                      },
                      "indexByName": {
                        "pin": 0,
                        "current": 1,
                        "policy": 2,
                        "source": 3,
                        "Value #B": 4,
                        "Value #C": 5,
                        "Value #D": 6
                      },
                      "renameByName": {
                        "pin": "Pin",
                        "current": "Pinned",
                        "policy": "Policy",
                        "source": "Source",
                        "Value #B": "Behind",
                        "Value #C": "Running",
                        "Value #D": "Lookup"
                      }
                    }
                  }
                }
              ]
            }
          },
          "description": "Every pin in the manifest (rendered from the repository's own variables and collections/requirements.yml). Behind counts newer upstream releases or cycles; Running compares what Prometheus sees running (podman_container_info, or the pin's own metric) with the pin, blank when nothing of it was seen; Lookup is blank for an unwatched pin.",
          "id": 8,
          "links": [],
          "title": "All pins",
          "vizConfig": {
            "group": "table",
            "kind": "VizConfig",
            "version": "13.2.4",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "mode": "fixed",
                    "fixedColor": "text"
                  },
                  "custom": {
                    "align": "left",
                    "cellOptions": {
                      "type": "auto"
                    },
                    "filterable": true,
                    "inspect": false
                  },
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "text",
                        "value": 0
                      }
                    ]
                  }
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Running"
                    },
                    "properties": [
                      {
                        "id": "mappings",
                        "value": [
                          {
                            "type": "value",
                            "options": {
                              "0": {
                                "text": "differs",
                                "color": "red",
                                "index": 0
                              },
                              "1": {
                                "text": "matches",
                                "color": "green",
                                "index": 1
                              }
                            }
                          }
                        ]
                      },
                      {
                        "id": "custom.cellOptions",
                        "value": {
                          "type": "color-text"
                        }
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Lookup"
                    },
                    "properties": [
                      {
                        "id": "mappings",
                        "value": [
                          {
                            "type": "value",
                            "options": {
                              "0": {
                                "text": "failed",
                                "color": "red",
                                "index": 0
                              },
                              "1": {
                                "text": "ok",
                                "color": "green",
                                "index": 1
                              }
                            }
                          }
                        ]
                      },
                      {
                        "id": "custom.cellOptions",
                        "value": {
                          "type": "color-text"
                        }
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
