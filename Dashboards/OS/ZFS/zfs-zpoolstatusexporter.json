        "description": "One row per vdev. The disk column joins to the SMART panels.",
        "fieldConfig": {
          "defaults": {},
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "state"
              },
              "properties": [
                {
                  "id": "custom.cellOptions",
                  "value": {
                    "type": "color-text"
                  }
                },
                {
                  "id": "mappings",
                  "value": [
                    {
                      "options": {
                        "ONLINE": {
                          "color": "green",
                          "index": 0
                        }
                      },
                      "type": "value"
                    },
                    {
                      "options": {
                        "pattern": "^(?!ONLINE$).*",
                        "result": {
                          "color": "red",
                          "index": 1
                        }
                      },
                      "type": "regex"
                    }
                  ]
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "errors"
              },
              "properties": [
                {
                  "id": "custom.cellOptions",
                  "value": {
                    "type": "color-background"
                  }
                },
                {
                  "id": "thresholds",
                  "value": {
                    "mode": "absolute",
                    "steps": [
