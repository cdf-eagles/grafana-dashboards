      {
        "datasource": {
          "type": "prometheus",
          "uid": "cei7lwvco16o0b"
        },
        "description": "Pools whose state is anything other than ONLINE.",
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "red",
                  "value": 1
                }
              ]
            }
          },
          "overrides": []
        },
        "gridPos": {
          "h": 4,
          "w": 4,
          "x": 0,
          "y": 1
        },
        "id": 2,
        "options": {
          "colorMode": "background",
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ]
          }
        },
        "targets": [
          {
            "datasource": {
              "type": "prometheus",
              "uid": "cei7lwvco16o0b"
            },
            "editorMode": "code",
            "expr": "count(zfs_pool_state{instance=~\"$instance\", pool=~\"$pool\", state=\"ONLINE\"} == 0) or vector(0)",
            "instant": true,
            "range": false,
            "refId": "A"
          }
        ],
        "title": "Pools not ONLINE",
        "type": "stat"
      },
